# ============================================================================
# SETU configuration.  Copy to `.env` and fill in what you need.
# Everything has a working default except the two API keys.
# ============================================================================

# ---------------------------------------------------------------- speech (STT/TTS)
# Required for voice input and spoken answers. Without it the UI falls back to
# browser speech recognition and the text path still works completely.
# Get one at https://elevenlabs.io -> Profile -> API Keys
ELEVENLABS_API_KEY=

# ------------------------------------------------------- deliberate (generative) path
# Optional. Enables the LLM answer path, which is explicitly OUTSIDE the 200 ms SLO.
# The default Reflex path is deterministic, extractive and needs no key at all.
# Get one at https://console.groq.com
GROQ_API_KEY=

# ============================================================================
# Everything below is optional. Prefix is SETU_.
# ============================================================================

# ---------------------------------------------------------------------- server
# SETU_HOST=0.0.0.0
# SETU_PORT=8000
# SETU_LOG_LEVEL=info
# SETU_CORS_ORIGINS=*

# --------------------------------------------------------------- latency budget
# The SLO. Optional pipeline stages are skipped rather than exceeding this.
# SETU_BUDGET__TOTAL_MS=200

# --------------------------------------------------------------- vector backend
# auto  -> Qdrant when reachable, otherwise the in-process exact store
# qdrant -> force Qdrant (set SETU_QDRANT_URL or SETU_QDRANT_PATH)
# flat  -> force the in-process exact store (default for the demo; fastest here)
# SETU_VECTOR_BACKEND=auto
# SETU_QDRANT_URL=http://localhost:6333
# SETU_QDRANT_PATH=./data/qdrant
# SETU_QDRANT_COLLECTION=setu_lattice

# ----------------------------------------------------------------- chunk lattice
# Tuned for MS MARCO's short passages - see docs/CHUNKING.md before changing.
# SETU_ATOMIC_MIN_CHARS=45
# SETU_ATOMIC_MAX_CHARS=240
# SETU_SEMANTIC_MAX_CHARS=420
# SETU_SEMANTIC_Z=0.45
# SETU_WINDOW_CHARS=300
# SETU_WINDOW_OVERLAP_MIN=0.14
# SETU_WINDOW_OVERLAP_MAX=0.50
# SETU_METADATA_PREFIX=true
# SETU_ENABLED_LAYERS=atomic,semantic,window,document

# --------------------------------------------------------------------- retrieval
# SETU_DENSE_K=40
# SETU_SPARSE_K=40
# SETU_FUSE_K=24
# SETU_RERANK_K=12
# SETU_FINAL_K=5
# SETU_RRF_K=60
# SETU_DENSE_WEIGHT=0.62
# SETU_SPARSE_WEIGHT=0.38

# -------------------------------------------------------------------- guardrails
# Raise to abstain more often, lower to answer more often. See docs/GUARDRAILS.md.
# SETU_TOPICALITY_MIN_SCORE=0.34
# SETU_TOPICALITY_MIN_MARGIN=0.015
# SETU_GROUNDEDNESS_MIN_COVERAGE=0.42
# SETU_TRUST_ABSTAIN_BELOW=45
# SETU_SAFETY_SIMILARITY_THRESHOLD=0.68
# SETU_NUMERIC_CONSISTENCY=true

# ---------------------------------------------------------------------- speech
# SETU_ELEVENLABS_STT_MODEL=scribe_v2
# SETU_ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
#
# The default voice is "Sarah" (EXAVITQu4vr4xnSDxMaL), a built-in voice that works on
# free accounts. Voices from the shared Voice Library return HTTP 402 on the free tier.
# List the voices your key can use:
#   curl -s -H "xi-api-key: $ELEVENLABS_API_KEY" https://api.elevenlabs.io/v1/voices
# SETU_ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ------------------------------------------------------------------------- llm
# Any OpenAI-compatible endpoint works. The model must honour JSON mode, because the
# deliberate path validates a strict schema (answer / citations / abstain / reason).
# List what your key can reach:
#   curl -s -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
# SETU_LLM_BASE_URL=https://api.groq.com/openai/v1
# SETU_LLM_MODEL=openai/gpt-oss-20b          # v1 deliberate path
# SETU_LLM_TIMEOUT_S=12
# SETU_RESEARCH_MODEL=openai/gpt-oss-120b    # SETU 2.0 research styles + analysis
# SETU_RESEARCH_FAST_MODEL=openai/gpt-oss-20b  # follow-up rewriting
# SETU_RESEARCH_TIMEOUT_S=45

# ------------------------------------------------------------ SETU 2.0 storage
# SETU_DATABASE_URL=sqlite:///./data/setu.db   # any SQLAlchemy URL, e.g. postgresql+psycopg://...
# SETU_COLLECTIONS_DIR=./data/collections
# SETU_MAX_UPLOAD_MB=25
# SETU_MAX_FILES_PER_UPLOAD=10
# SETU_MAX_URL_MB=15

# ------------------------------------------------------------------- security
# Set before exposing the server: required on every mutating / paid route.
# SETU_API_TOKEN=
# SETU_RATE_LIMIT_PER_MIN=60
# SETU_CORS_ORIGINS=https://your-domain.example

# ---------------------------------------------------------------------- caching
# Where model weights and dataset shards are cached.
# HF_HOME=./.cache/huggingface
